index c8783c1..449de8a 100644
--- a/config/app.json
+++ b/config/app.json
@@ -1,4 +1,5 @@
 {
   "sessionTtlMinutes": 30,
+  "cleanupBatchSize": 50,
   "cleanupBatch": 50
 }
diff --git a/worker/cleanup.js b/worker/cleanup.js
index 07975bd..c6f46fb 100644
--- a/worker/cleanup.js
+++ b/worker/cleanup.js
@@ -10,7 +10,7 @@ export function expired(sessions, cfg, nowMs) {
 export function run(storePath, configPath, nowMs = Date.now()) {
   const cfg = JSON.parse(readFileSync(configPath, 'utf8'));
   const sessions = JSON.parse(readFileSync(storePath, 'utf8'));
-  const drop = new Set(expired(sessions, cfg, nowMs).slice(0, cfg.cleanupBatch).map((s) => s.id));
+  const drop = new Set(expired(sessions, cfg, nowMs).slice(0, cfg.cleanupBatchSize ?? cfg.cleanupBatch).map((s) => s.id));
   writeFileSync(storePath, JSON.stringify(sessions.filter((s) => !drop.has(s.id))));
   return drop.size;
 }
