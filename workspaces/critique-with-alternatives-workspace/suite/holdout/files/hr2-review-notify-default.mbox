new file mode 100644
index 0000000..4f49f6f
--- /dev/null
+++ b/src/mailer.js
@@ -0,0 +1,4 @@
+// Who gets the activity email. Users with notify off get nothing.
+export function recipients(store, userIds) {
+  return userIds.filter((id) => store.get(id).notify);
+}
diff --git a/src/prefs.js b/src/prefs.js
new file mode 100644
index 0000000..e4f14fd
--- /dev/null
+++ b/src/prefs.js
@@ -0,0 +1,10 @@
+export const DEFAULTS = { notify: true, digest: 'daily', theme: 'light' };
+
+// Stored records keep only the fields a user changed; everything else comes from DEFAULTS when read.
+export function readPrefs(stored = {}) {
+  return { ...DEFAULTS, ...stored };
+}
+
+export function compact(prefs) {
+  return Object.fromEntries(Object.entries(prefs).filter(([key, value]) => DEFAULTS[key] !== value));
+}
diff --git a/src/signup.js b/src/signup.js
new file mode 100644
index 0000000..504cd60
--- /dev/null
+++ b/src/signup.js
@@ -0,0 +1,4 @@
+// A new user starts with the default preferences.
+export function onSignup(store, userId) {
+  store.set(userId, {});
+}
diff --git a/src/store.js b/src/store.js
new file mode 100644
index 0000000..28a921d
--- /dev/null
+++ b/src/store.js
@@ -0,0 +1,13 @@
+import { readFileSync, writeFileSync } from 'node:fs';
+import { compact, readPrefs } from './prefs.js';
+
+export function openStore(file) {
+  const data = JSON.parse(readFileSync(file, 'utf8'));
+  return {
+    get: (userId) => readPrefs(data[userId]),
+    set(userId, prefs) {
+      data[userId] = compact({ ...readPrefs(data[userId]), ...prefs });
+      writeFileSync(file, JSON.stringify(data, null, 2) + '\n');
+    },
+  };
+}
diff --git a/test/prefs.test.js b/test/prefs.test.js
new file mode 100644
index 0000000..ac269b9
--- /dev/null
+++ b/test/prefs.test.js
@@ -0,0 +1,19 @@
+import { test } from 'node:test';
+import assert from 'node:assert/strict';
+import { DEFAULTS, compact, readPrefs } from '../src/prefs.js';
+import { recipients } from '../src/mailer.js';
+
+test('missing fields come from the defaults', () => {
+  assert.deepEqual(readPrefs({ theme: 'dark' }), { ...DEFAULTS, theme: 'dark' });
+});
+
+test('only changed fields are stored', () => {
+  assert.deepEqual(compact(readPrefs({})), {});
+  assert.deepEqual(compact({ ...DEFAULTS, theme: 'dark' }), { theme: 'dark' });
+});
+
+test('users with notify off get no email', () => {
+  const data = { a: {}, b: { notify: false } };
+  const store = { get: (id) => readPrefs(data[id]) };
+  assert.deepEqual(recipients(store, ['a', 'b']), ['a']);
+});

From 21826f4dcc5b77d8f2ecc35e9e5f1a7a5a43d9a8 Mon Sep 17 00:00:00 2001
From: fixture <fixture@example.invalid>
Date: Mon, 3 Mar 2025 09:00:00 +0000
Subject: [PATCH 2/3] prefs: backfill digest before changing its default

Stored records leave out values equal to the default, so changing a default
changes it for every user who never touched the setting. Write the current
default into those records first; the default itself changes in the next commit.
---
 data/prefs.json            | 14 ++++++++++----
 scripts/backfill-digest.js |  7 +++++++
 2 files changed, 17 insertions(+), 4 deletions(-)
 create mode 100644 scripts/backfill-digest.js

diff --git a/data/prefs.json b/data/prefs.json
index 9b8f614..d25a53f 100644
--- a/data/prefs.json
+++ b/data/prefs.json
@@ -1,12 +1,18 @@
 {
-  "u1": {},
+  "u1": {
+    "digest": "daily"
+  },
   "u2": {
-    "theme": "dark"
+    "theme": "dark",
+    "digest": "daily"
   },
   "u3": {
-    "notify": false
+    "notify": false,
+    "digest": "daily"
+  },
+  "u4": {
+    "digest": "daily"
   },
-  "u4": {},
   "u5": {
     "digest": "weekly",
     "theme": "dark"
diff --git a/scripts/backfill-digest.js b/scripts/backfill-digest.js
new file mode 100644
index 0000000..d32b728
--- /dev/null
+++ b/scripts/backfill-digest.js
@@ -0,0 +1,7 @@
+// One-off: writes digest: 'daily' into every stored record that has no digest yet.
+import { readFileSync, writeFileSync } from 'node:fs';
+
+const file = process.argv[2] ?? 'data/prefs.json';
+const data = JSON.parse(readFileSync(file, 'utf8'));
+for (const prefs of Object.values(data)) prefs.digest ??= 'daily';
+writeFileSync(file, JSON.stringify(data, null, 2) + '\n');

