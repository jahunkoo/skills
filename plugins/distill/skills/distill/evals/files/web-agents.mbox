diff --git a/apps/web/src/api/client.ts b/apps/web/src/api/client.ts
new file mode 100644
index 0000000..aed320f
--- /dev/null
+++ b/apps/web/src/api/client.ts
@@ -0,0 +1,10 @@
+// Every request goes through here: attaches the auth header and refreshes an expired token once.
+export async function request(path: string, init: RequestInit = {}): Promise<Response> {
+  const res = await fetch(`${process.env.API_BASE_URL}${path}`, withAuth(init));
+  if (res.status !== 401) return res;
+  await refreshToken();
+  return fetch(`${process.env.API_BASE_URL}${path}`, withAuth(init));
+}
+
+declare function withAuth(init: RequestInit): RequestInit;
+declare function refreshToken(): Promise<void>;
